# Sample environment variables for the dev environment.
# Copy to server/.env with: cp server/.env.example server/.env
# The app runs on the host machine, so the database host is localhost.
# Only use the "postgres" hostname when the server runs inside the Docker network.

DATABASE_URL="postgresql://recommender:recommender@localhost:5432/recommender?schema=public"
SHADOW_DATABASE_URL="postgresql://recommender:recommender@localhost:5432/recommender_shadow?schema=public"

# Google Analytics 4 property ID (used by the recommender-api module).
# For dev it can be empty or a placeholder value.
GA4_PROPERTY_ID=""

# SHOPIFY_API_KEY, SHOPIFY_API_SECRET, SCOPES, HOST, BACKEND_PORT, FRONTEND_PORT
# are injected by the Shopify CLI when you run yarn dev. Do not declare them here.

#--------------------------------------------------------------------------
# AI chatbot (RAG) configuration
#--------------------------------------------------------------------------
# Default chat LLM provider for shops that have not chosen one in the Config tab.
# Supported values: openai | gemini | groq | ollama
CHAT_DEFAULT_LLM_PROVIDER="openai"

# Default chat model for the default provider.
CHAT_DEFAULT_LLM_MODEL="gpt-4o-mini"

# Embedding provider is fixed at the infrastructure level (see architecture notes).
# Supported values: gemini | ollama
# Gemini text-embedding-004 (768 dims) has a free tier and is the default.
CHAT_EMBEDDING_PROVIDER="gemini"

# OpenAI API key (default chat provider). Fill in your own key.
OPENAI_API_KEY=""

# Google AI Studio API key. Used for Gemini embeddings (free tier) and
# optionally for Gemini chat.
GEMINI_API_KEY=""

# Groq API key (free-tier chat option).
GROQ_API_KEY=""

# Base URL of a self-hosted Ollama instance (free local models).
# Example: http://localhost:11434
OLLAMA_BASE_URL=""

# Encryption key for per-shop API key overrides stored in the database
# (ChatShopConfig.llmApiKeyEnc). Must be a random 32-byte hex string.
# Generate with: openssl rand -hex 32
CONFIG_ENCRYPTION_KEY=""

# Redis URL (rate limiting and BullMQ job queue for catalog embedding sync).
# The app runs on the host machine, so use localhost here.
REDIS_URL="redis://localhost:6379"
# Embedding provider and model (fixed infrastructure level, pgvector is vector(768))
CHAT_DEFAULT_EMBEDDING_MODEL="gemini-embedding-001"

# Port for the NestJS devtools integration (debug UI). Only used when
# NODE_ENV is not production. Use a different value per instance if you
# run more than one Nest process at a time, otherwise the second one
# crashes with EADDRINUSE.
DEVTOOLS_PORT="5434"
