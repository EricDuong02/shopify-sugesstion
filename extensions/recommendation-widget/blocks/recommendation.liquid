{% comment %}
  Recommendation campaign app block. Campaigns are selected by ID from the
  embedded admin because app block schemas cannot load dynamic app data.
{% endcomment %}

{{ 'recommendation.css' | asset_url | stylesheet_tag }}

<div
  class="recommendation-widget"
  data-recommendation-id="{{ block.settings.campaign_id | strip | escape }}"
  data-page-type="{{ request.page_type | escape }}"
  data-heading="{{ block.settings.heading | strip | escape }}"
  data-limit="{{ block.settings.product_limit }}"
  data-columns="{{ block.settings.columns }}"
  {{ block.shopify_attributes }}
>
  <div class="recommendation-widget__loading" role="status">
    {{ block.settings.loading_text | escape }}
  </div>
</div>

<script src="{{ 'recommendation.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Recommendation campaign",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "campaign_id",
      "label": "Campaign ID",
      "info": "Copy the ID from the Recommendation admin page."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Products to show",
      "min": 1,
      "max": 50,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "loading_text",
      "label": "Loading text",
      "default": "Loading recommendations..."
    }
  ]
}
{% endschema %}
