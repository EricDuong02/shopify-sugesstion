{% comment %}
  Recommendation app block. The block location controls where campaigns render;
  an optional campaign ID pins a campaign independently of the current template.
{% endcomment %}

{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
{{ 'recommendation.css' | asset_url | stylesheet_tag }}

<div
  class="recommendation-widget"
  data-recommendation-id="{{ block.settings.campaign_id | strip | escape }}"
  data-page-type="{{ request.page_type | escape }}"
  data-heading="{{ block.settings.heading | strip | escape }}"
  data-limit="{{ block.settings.product_limit }}"
  data-columns="{{ block.settings.columns }}"
  data-mobile-columns="{{ block.settings.mobile_columns }}"
  data-rows="{{ block.settings.rows }}"
  data-previous-label="{{ 'recommendation_widget.previous' | t | escape }}"
  data-next-label="{{ 'recommendation_widget.next' | t | escape }}"
  data-row-label="{{ 'recommendation_widget.row' | t | escape }}"
  data-original-price-label="{{ 'recommendation_widget.original_price' | t | escape }}"
  data-sale-price-label="{{ 'recommendation_widget.sale_price' | t | escape }}"
  data-loading-text="{{ block.settings.loading_text | strip | escape }}"
  {{ block.shopify_attributes }}
>
  <div class="recommendation-widget__loading" role="status">
    {{ block.settings.loading_text | escape }}
  </div>
</div>

<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>
<script src="{{ 'recommendation.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Recommendation campaigns",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "campaign_id",
      "label": "Campaign ID (optional)",
      "info": "Leave blank to discover active campaigns for this shop. Enter a campaign ID to pin one campaign to this block."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Products to load",
      "info": "The total number of products available to browse.",
      "min": 1,
      "max": 50,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop products visible",
      "info": "Number of product cards visible horizontally on desktop.",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "label": "Mobile products visible",
      "info": "Number of product cards visible horizontally on mobile.",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "rows",
      "label": "Product rows",
      "info": "Number of independent horizontal product rows.",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 1
    },
    {
      "type": "text",
      "id": "loading_text",
      "label": "Loading text",
      "default": "Loading recommendations..."
    }
  ]
}
{% endschema %}
